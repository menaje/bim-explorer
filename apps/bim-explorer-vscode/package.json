{
  "name": "bim-explorer",
  "displayName": "BIM Explorer",
  "description": "Local-first read-only IFC, federated BIM, reference mesh, E57, and bounded LAS/LAZ point exploration",
  "version": "0.1.0",
  "publisher": "menaje",
  "private": true,
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/menaje/bim-explorer.git"
  },
  "type": "commonjs",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCustomEditor:bimExplorer.ifcEditor",
    "onCommand:bimExplorer.openWith",
    "onCommand:bimExplorer.cancel",
    "onCommand:bimExplorer.closeModel",
    "onCommand:bimExplorer.retry",
    "onCommand:bimExplorer.showDiagnostics",
    "onCommand:bimExplorer.pickVisiblePoint",
    "onCommand:bimExplorer.refinePointLod",
    "onCustomEditor:bimExplorer.federationEditor",
    "onCommand:bimExplorer.openFederation",
    "onCommand:bimExplorer.verifyFederatedAnchors",
    "onCommand:bimExplorer.disposeFederatedSurface"
  ],
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "bimExplorer.ifcEditor",
        "displayName": "BIM Explorer",
        "selector": [
          {
            "filenamePattern": "*.ifc"
          },
          {
            "filenamePattern": "*.gltf"
          },
          {
            "filenamePattern": "*.glb"
          },
          {
            "filenamePattern": "*.e57"
          },
          {
            "filenamePattern": "*.las"
          },
          {
            "filenamePattern": "*.laz"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "bimExplorer.federationEditor",
        "displayName": "Federated BIM Surface",
        "selector": [
          {
            "filenamePattern": "*.bimfed.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "bimExplorer.openWith",
        "title": "BIM Explorer: Open BIM Read-Only"
      },
      {
        "command": "bimExplorer.cancel",
        "title": "BIM Explorer: Cancel Model Open"
      },
      {
        "command": "bimExplorer.closeModel",
        "title": "BIM Explorer: Close Model"
      },
      {
        "command": "bimExplorer.retry",
        "title": "BIM Explorer: Retry Model Open"
      },
      {
        "command": "bimExplorer.showDiagnostics",
        "title": "BIM Explorer: Show Local Diagnostics"
      },
      {
        "command": "bimExplorer.pickVisiblePoint",
        "title": "BIM Explorer: Pick Visible Point"
      },
      {
        "command": "bimExplorer.refinePointLod",
        "title": "BIM Explorer: Refine Point Detail"
      },
      {
        "command": "bimExplorer.openFederation",
        "title": "BIM Explorer: Open Federated Surface"
      },
      {
        "command": "bimExplorer.verifyFederatedAnchors",
        "title": "BIM Explorer: Verify Visible Federated Anchors"
      },
      {
        "command": "bimExplorer.disposeFederatedSurface",
        "title": "BIM Explorer: Close Federated Surface"
      }
    ],
    "configuration": {
      "title": "BIM Explorer",
      "properties": {
        "bimExplorer.maximumSourceBytes": {
          "type": "number",
          "default": 67108864,
          "minimum": 1,
          "maximum": 67108864,
          "description": "Maximum local source byte length admitted by the read-only editor; E57 is capped at 32 MiB and LAS/LAZ at 8 MiB."
        },
        "bimExplorer.openTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 120000,
          "description": "Maximum local Worker conversion time before the editor fails closed."
        },
        "bimExplorer.ifcProfile": {
          "type": "string",
          "default": "ReferenceView_V1.2",
          "enum": [
            "ReferenceView_V1.2"
          ],
          "description": "IFC profile used for local read-only conversion."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "The editor is read-only, local-only, bounded, and does not execute model content."
    }
  },
  "dependencies": {
    "laz-perf": "0.0.6",
    "web-ifc": "0.0.77"
  }
}
