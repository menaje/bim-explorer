    "qualify:bim-surface:package": "node scripts/qualify-bim-surface-package.mjs",
    "qualify:bim-surface:v0.2": "node scripts/qualify-federated-bim-surface.mjs",
    "qualify:spatial-integration": "node scripts/qualify-spatial-integration.mjs",
    "qualify:openbim": "node scripts/qualify-openbim-explorer.mjs",
    "qualify:federation": "node scripts/qualify-bim-federation.mjs",
    "qualify:federation:product-scale": "node scripts/qualify-bim-federation-product-scale.mjs",
    "qualify:e57:probe": "node scripts/qualify-e57-public-sample.mjs",
