{
  "name": "bim-explorer",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first open-source BIM exploration product",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "adapters/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run check:text && npm run check:repository && npm run check:docs && npm run check:compatibility && npm test",
    "check:text": "node scripts/check-text.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:compatibility": "node scripts/check-viewer-core-compatibility.mjs && node scripts/check-ifc-engine-compatibility.mjs",
    "qualify:ifc:web": "node scripts/qualify-ifc-engine.mjs --engine web-ifc",
    "qualify:ifc:mapped": "node scripts/qualify-ifc-engine.mjs --engine web-ifc --fixture mapped",
    "test": "node --test tests/**/*.test.mjs"
  }
}
