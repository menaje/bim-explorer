{
  "name": "bim-explorer",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first open-source BIM exploration product",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "adapters/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:vscode-worker": "node scripts/build-vscode-worker.mjs",
    "check": "npm run check:text && npm run check:repository && npm run check:docs && npm run check:generated && npm run check:compatibility && npm test",
    "check:text": "node scripts/check-text.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:generated": "node scripts/build-vscode-worker.mjs --check",
    "check:compatibility": "node scripts/check-viewer-core-compatibility.mjs && node scripts/check-ifc-engine-compatibility.mjs && node scripts/check-bim-model-source-compatibility.mjs && node scripts/check-bim-renderer-3d-compatibility.mjs && node scripts/check-bim-semantic-explorer-compatibility.mjs && node scripts/check-bim-product-shell-compatibility.mjs",
    "fetch:ifc:public": "node scripts/fetch-public-ifc-fixture.mjs",
    "probe:browser-gpu": "node scripts/serve-browser-gpu-probe.mjs",
    "probe:browser-worker": "node scripts/serve-browser-worker-probe.mjs",
    "probe:semantic": "node scripts/serve-semantic-explorer-probe.mjs",
    "package:vscode": "node scripts/package-vscode-extension.mjs",
    "start:web": "node scripts/serve-bim-explorer-web.mjs",
    "qualify:ifc:public": "node scripts/qualify-public-ifc-performance.mjs",
    "qualify:ifc:web": "node scripts/qualify-ifc-engine.mjs --engine web-ifc",
    "qualify:ifc:mapped": "node scripts/qualify-ifc-engine.mjs --engine web-ifc --fixture mapped",
    "qualify:ifc:negative": "node scripts/qualify-ifc-negative-corpus.mjs --engine web-ifc",
    "qualify:ifc:cancel-in-call": "node scripts/qualify-ifc-in-call-cancellation.mjs --engine web-ifc",
    "qualify:bim-source": "node scripts/qualify-bim-model-source.mjs",
    "qualify:bim-source:public": "node scripts/qualify-public-bim-model-source.mjs",
    "qualify:product:web": "node scripts/qualify-bim-product-shell.mjs",
    "qualify:product:web:public": "node scripts/qualify-bim-product-shell.mjs --fixture public",
    "qualify:product:vscode": "node scripts/qualify-vscode-custom-editor.mjs",
    "qualify:product:vscode-install": "node scripts/qualify-vscode-vsix-install.mjs",
    "qualify:renderer:public": "node scripts/qualify-public-bim-renderer-3d.mjs",
    "test": "node --test tests/**/*.test.mjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1"
  }
}
